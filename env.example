# --- SellerCloud ---
# Server ID is the subdomain in your REST endpoint:
#   https://{SELLERCLOUD_SERVER_ID}.api.sellercloud.com/rest
SELLERCLOUD_SERVER_ID=xx
SELLERCLOUD_USERNAME=integration-user@yourcompany.com
SELLERCLOUD_PASSWORD=change-me

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=catalog
POSTGRES_USER=analytics
POSTGRES_PASSWORD=changeme
# Or set a single DSN instead of the five vars above:
# DATABASE_URL=postgresql://analytics:changeme@localhost:5432/catalog
